{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!dev-dist",
      "!coverage",
      "!storybook-static",
      "!docs",
      "!README.md",
      "!catalog-info.yaml",
      "!mkdocs.yml"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}
